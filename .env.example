# Database Mode: local, aws, or custom
DB_MODE=local

# Local PostgreSQL Configuration (DB_MODE=local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=postgres

# AWS RDS Configuration (DB_MODE=aws)
# AWS_DB_HOST=your-rds-endpoint.rds.amazonaws.com
# AWS_DB_PORT=5432
# AWS_DB_USER=postgres
# AWS_DB_PASSWORD=your-aws-db-password
# AWS_DB_NAME=postgres

# Custom Database Configuration (DB_MODE=custom)
# DB_HOST=your-db-host.com
# DB_PORT=5432
# DB_USER=your-user
# DB_PASSWORD=your-password
# DB_NAME=your-database

# Database cloning (useful for parallel eval runs)
DB_CLONE_CREATE_RETRIES=10

# Optional: override LiveSQLBench assets root (KB + base column meanings)
# Use this when the assets live outside the repo (e.g., remote/shared mount).
# LIVESQLBENCH_ROOT=/path/to/livesqlbench-base-full-v1

# Eval mismatch logging: off | basic | detailed
EVAL_MISMATCH_LOG_LEVEL=basic

# Runner limits
EVAL_MAX_QUERIES_PER_CALL=5

# AWS Credentials (REQUIRED for Bedrock models)
AWS_REGION=us-east-2
# Optional: prefer a shared credentials profile from ~/.aws/credentials
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token

# Anthropic API Key (for direct Claude API access)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API Key (for GPT models)
# OPENAI_API_KEY=your-openai-api-key
